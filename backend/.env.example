# Copia este archivo como backend/.env y ajusta los valores.
# Ninguno es obligatorio en desarrollo: hay valores por defecto.

# Clave secreta de Django (genera una nueva en producción).
DJANGO_SECRET_KEY=django-insecure-cambia-esta-clave

# 1 = modo desarrollo, 0 = modo producción.
DJANGO_DEBUG=1

# Hosts permitidos, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes autorizados para CORS, separados por comas.
DJANGO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
